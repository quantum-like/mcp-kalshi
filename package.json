{
	"name": "@iqai/mcp-kalshi",
	"version": "0.1.6",
	"description": "MCP server for interacting with Kalshi prediction markets - trade, manage portfolio, and discover markets.",
	"main": "dist/index.js",
	"type": "module",
	"bin": {
		"mcp-kalshi": "dist/index.js"
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsc && shx chmod +x dist/index.js",
		"test": "node --import tsx --test test/**/*.test.ts",
		"prepare": "husky",
		"watch": "tsc --watch",
		"start": "node dist/index.js",
		"publish-packages": "pnpm run build && changeset publish",
		"format": "biome format . --write",
		"lint": "biome check ."
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"axios": "1.21.0",
		"dedent": "^1.6.0",
		"fastmcp": "^3.30.1",
		"kalshi-typescript": "3.35.0",
		"zod": "^3.25.7"
	},
	"devDependencies": {
		"@biomejs/biome": "*",
		"@changesets/cli": "^2.29.4",
		"@types/node": "^22.15.19",
		"husky": "^9.0.0",
		"lint-staged": "^15.0.0",
		"shx": "^0.3.4",
		"tsx": "^4.21.0",
		"typescript": "^5.8.3",
		"zod-to-json-schema": "^3.24.5"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"biome check --write --organize-imports-enabled=false --no-errors-on-unmatched"
		]
	},
	"pnpm": {
		"overrides": {
			"axios": "1.21.0"
		},
		"onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "tldjs"]
	}
}
